# Primer nastavitev. Kopiraj v .env in prilagodi; .env ne gre v git.
# Spremenljivke, ki so že nastavljene v okolju, imajo prednost pred .env.

# Vrata, na katerih posluša strežnik (privzeto 3000).
PORT=3000

# Datoteka baze SQLite (privzeto data/popravni-izpiti.sqlite).
DB_PATH=data/popravni-izpiti.sqlite

# Geslo za stran /profesor (pregled prijav in izvoz CSV). Brez gesla je stran zaprta.
# Pravo geslo vpiši samo v svojo .env, nikoli v git.
TEACHER_PASSWORD=
